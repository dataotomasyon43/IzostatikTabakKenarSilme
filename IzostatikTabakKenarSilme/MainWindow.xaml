<Window x:Class="IzostatikTabakKenarSilme.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IzostatikTabakKenarSilme.Controls"
        Title="İzostatik Tabak Kenar Silme"
        Height="800"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource PrimaryText}">

    <Window.Resources>
        <!-- Üst (yatay) menü butonu: simge + yazı yan yana.
             Seçili sayfa (Tag="Active"): vurgu renginde yazı/simge,
             altta 3 px vurgu çizgisi ve hafif dolgu. -->
        <Style x:Key="TopMenuButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="56"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <Border x:Name="Tint"
                                    Background="{DynamicResource AccentColor}"
                                    Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                            <Border x:Name="Bar"
                                    Background="{DynamicResource AccentColor}"
                                    Height="3"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.06"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.10"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.18"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menü simgeleri: çizgi rengi butonun Foreground'undan -->
        <Style x:Key="MenuIconPathStyle" TargetType="{x:Type Path}">
            <Setter Property="Stroke"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ÜST SABİT HEADER (pencere modunda buradan tutup taşınır) -->
        <Border x:Name="HeaderBorder"
                Grid.Row="0"
                MouseLeftButtonDown="HeaderBorder_MouseLeftButtonDown"
                Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <!-- Vektör logo: renkleri temadan (LogoMarkColor / LogoAccentColor) -->
                    <controls:LogoView x:Name="Logo" HorizontalAlignment="Left" Width="150" Height="130"/>
                </Grid>

                <StackPanel Orientation="Vertical"
                            VerticalAlignment="Center" Grid.Column="1">
                    <TextBlock Text="İZOSTATİK TABAK KENAR SİLME"
                               FontSize="19"
                               FontWeight="Bold"/>
                    <TextBlock Text="Operatör Paneli"
                               Foreground="{DynamicResource SecondaryText}"
                               FontSize="12"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Başlıktaki simgeli butonların ortak stili (mod butonları
                         ve tema butonu). Simge üstte, küçük etiket altta.

                         Renk: butonun Foreground'u. Simge çizgisi, etiket,
                         aktif kenarlık, dolgu ve alt çizgi hep bu renkten gelir;
                         her mod butonu kendi rengini Foreground ile verir.

                         Aktif (Tag="Active"): 2 px renkli kenarlık + hafif
                         renk dolgusu + altta renkli çizgi. -->
                    <Grid.Resources>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Width" Value="73"/>
                            <Setter Property="Height" Value="58"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="4,2"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Grid.RenderTransform>
                                            <Border x:Name="Frame"
                                                    Background="{DynamicResource CardBackground}"
                                                    BorderBrush="{DynamicResource PanelBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"/>
                                            <Border x:Name="Tint"
                                                    Background="{TemplateBinding Foreground}"
                                                    CornerRadius="6"
                                                    Opacity="0"/>
                                            <Border x:Name="Bar"
                                                    Background="{TemplateBinding Foreground}"
                                                    Height="4"
                                                    VerticalAlignment="Bottom"
                                                    CornerRadius="0,0,6,6"
                                                    Visibility="Collapsed"/>
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <!-- Sıra önemli: sonraki tetikleyici öncekini ezer. -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tint" Property="Opacity" Value="0.08"/>
                                            </Trigger>
                                            <Trigger Property="Tag" Value="Active">
                                                <Setter TargetName="Frame" Property="BorderBrush"
                                                        Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="Tint" Property="Opacity" Value="0.18"/>
                                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <!-- Basılıyken belirgin geri bildirim: koyu dolgu + hafif küçülme -->
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Tint" Property="Opacity" Value="0.38"/>
                                                <Setter TargetName="Root" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="0.93" ScaleY="0.93"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="{x:Type controls:HoldButton}"
                               BasedOn="{StaticResource {x:Type Button}}"/>
                        <Style TargetType="{x:Type Path}">
                            <Setter Property="Stroke"
                                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            <Setter Property="StrokeThickness" Value="2.2"/>
                            <Setter Property="StrokeStartLineCap" Value="Round"/>
                            <Setter Property="StrokeEndLineCap" Value="Round"/>
                            <Setter Property="StrokeLineJoin" Value="Round"/>
                        </Style>
                        <Style x:Key="IconLabelStyle" TargetType="{x:Type TextBlock}">
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,2,0,0"/>
                        </Style>
                    </Grid.Resources>
                    <WrapPanel Grid.Row="0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                        <!-- MAKİNE DURUMU: Bağlantı yok / Arıza Var / Çalışıyor / Hazır.
                             Kenarlık rengi ve kalınlığı koddan (UpdateMachineState)
                             ayarlanır; tasarım ve boyut PLC kartıyla aynı.
                             Arıza varken dokununca Aktif Alarmlar penceresi açılır. -->
                        <Border x:Name="MachineStateCard"
                            MouseLeftButtonUp="MachineStateCard_MouseLeftButtonUp"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource PanelBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,7"
                            Margin="4"
                                Width="130" Height="50">
                            <StackPanel>
                                <TextBlock Text="MAKİNE DURUMU"
                                       FontSize="10"
                                       Foreground="{DynamicResource SecondaryText}"/>
                                <TextBlock x:Name="MachineStateText"
                                       Text="● Bağlantı bekleniyor"
                                       Foreground="{DynamicResource WarningColor}"
                                       FontWeight="Bold"
                                       Margin="0,3,0,0" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource PanelBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,7"
                            Margin="4" Width="119" Height="50">
                            <StackPanel>
                                <TextBlock Text="ÇALIŞMA MODU"
                                       FontSize="10"
                                       Foreground="{DynamicResource SecondaryText}"/>
                                <TextBlock x:Name="ModeText"
                                       Text="-"
                                       FontWeight="Bold"
                                       Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Tema butonu: koyu temadayken güneş (açığa geç),
                             açık temadayken ay (koyuya geç) gösterilir. -->
                        <Button x:Name="ThemeButton"
                                ToolTip="Tema değiştir"
                                AutomationProperties.Name="Tema değiştir"
                                Click="ThemeButton_Click" Width="50" Height="50">
                            <StackPanel>
                                <Grid Width="30" Height="30" HorizontalAlignment="Center">
                                    <Viewbox x:Name="ThemeSunIcon">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M16,12 A4,4 0 1 1 8,12 A4,4 0 1 1 16,12 Z M12,2.5 V4.5 M12,19.5 V21.5 M5.28,5.28 L6.7,6.7 M17.3,17.3 L18.72,18.72 M2.5,12 H4.5 M19.5,12 H21.5 M5.28,18.72 L6.7,17.3 M17.3,6.7 L18.72,5.28"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Viewbox x:Name="ThemeMoonIcon" Visibility="Collapsed">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M20,14.5 A8.5,8.5 0 1 1 9.5,4 A6.8,6.8 0 0 0 20,14.5 Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- ÇALIŞMA MODU BUTONLARI: tıklanınca Mode tag'ine
                     CommandParameter'daki değer yazılır.
                     0 Kapalı, 1 Güvenli, 2 Manuel, 3 Otomatik -->
                    <!-- Simgeli butonlar (stil yukarıdaki Grid.Resources'ta). Simgeler 24x24 SVG yol
                     verisidir; renk butonun Foreground'undan gelir:
                     Kapalı beyaz, Güvenli yeşil, Manuel turuncu, Otomatik mavi. -->
                    <!-- Mod butonları + ışıklı butonun 5. tuşunun ekrandaki karşılığı -->
                    <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <StackPanel x:Name="ModeButtonsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" Width="326">

                        <!-- 0: Kapalı — güç simgesi -->
                        <Button x:Name="ModeKapaliButton"
                            Foreground="{DynamicResource ModeKapaliColor}"
                            CommandParameter="0"
                            ToolTip="Kapalı"
                            AutomationProperties.Name="Kapalı"
                            Click="ModeButton_Click" Width="73">
                            <StackPanel>
                                <Viewbox Width="30" Height="30" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12,3 L12,11 M7.1,6.2 A7.5,7.5 0 1 0 16.9,6.2"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="KAPALI" Style="{StaticResource IconLabelStyle}"/>
                            </StackPanel>
                        </Button>

                        <!-- 1: Güvenli — kalkan + onay -->
                        <Button x:Name="ModeGuvenliButton"
                            Foreground="{DynamicResource ModeGuvenliColor}"
                            CommandParameter="1"
                            ToolTip="Güvenli Mod"
                            AutomationProperties.Name="Güvenli Mod"
                            Click="ModeButton_Click" Width="73">
                            <StackPanel>
                                <Viewbox Width="30" Height="30" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12,2.5 L19.5,5.5 V11 C19.5,15.8 16.3,19.8 12,21.5 C7.7,19.8 4.5,15.8 4.5,11 V5.5 Z M8.5,12 L11,14.5 L15.5,9.5"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="GÜVENLİ" Style="{StaticResource IconLabelStyle}"/>
                            </StackPanel>
                        </Button>

                        <!-- 2: Manuel — el -->
                        <Button x:Name="ModeManuelButton"
                            Foreground="{DynamicResource ModeManuelColor}"
                            CommandParameter="2"
                            ToolTip="Manuel Mod"
                            AutomationProperties.Name="Manuel Mod"
                            Click="ModeButton_Click" Width="73">
                            <StackPanel>
                                <Viewbox Width="30" Height="30" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M7,12.5 V6 A1.5,1.5 0 0 1 10,6 V11.5 M10,11 V4.5 A1.5,1.5 0 0 1 13,4.5 V11 M13,11 V5.5 A1.5,1.5 0 0 1 16,5.5 V11.5 M16,12 V8.5 A1.5,1.5 0 0 1 19,8.5 V15 A6.5,6.5 0 0 1 12.5,21.5 H12 A6.5,6.5 0 0 1 6.8,18.9 L3.6,15.4 A1.5,1.5 0 0 1 5.9,13.5 L7,14.6"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="MANUEL" Style="{StaticResource IconLabelStyle}"/>
                            </StackPanel>
                        </Button>

                        <!-- 3: Otomatik — döngü + oynat -->
                        <Button x:Name="ModeOtomatikButton"
                            Foreground="{DynamicResource ModeOtomatikColor}"
                            CommandParameter="3"
                            ToolTip="Otomatik Mod"
                            AutomationProperties.Name="Otomatik Mod"
                            Click="ModeButton_Click" Width="73">
                            <StackPanel>
                                <Viewbox Width="30" Height="30" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M20,12 A8,8 0 1 1 17.66,6.34 M17.9,2.6 L17.66,6.34 L13.9,6.1"/>
                                        <Path Data="M10,8.5 L15.5,12 L10,15.5 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                          StrokeThickness="1"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="OTOMATİK" Style="{StaticResource IconLabelStyle}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Height="44" Margin="6,0" VerticalAlignment="Center"
                            Background="{DynamicResource PanelBorder}"/>

                    <!-- 5. tuş (START / STOP / RESET): ışıklı butondaki 5. tuşun
                         aynısı; görevi ve rengi duruma göre değişir, basılı
                         tutulur (bas TRUE, bırak FALSE). Koddan güncellenir
                         (UpdateCycleButton). -->
                    <controls:HoldButton x:Name="CycleButton"
                            Width="80"
                            Foreground="{DynamicResource OkColor}"
                            ToolTip="Işıklı butonun 5. tuşu"
                            AutomationProperties.Name="Start / Stop / Reset"
                            Pressed="CycleButton_Pressed"
                            Released="CycleButton_Released">
                        <StackPanel x:Name="CycleContent">
                            <Viewbox Width="30" Height="30" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="CycleIcon"
                                          Data="M8,5 L19,12 L8,19 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="CycleLabel" Text="START" Style="{StaticResource IconLabelStyle}"/>
                        </StackPanel>
                    </controls:HoldButton>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ÜST MENÜ (yatay): OTOMATİK, AYARLAR, ÜRETİM, ARIZALAR ve
             sağda yalnızca simgeyle GENEL. Seçili sekme Tag="Active"
             ile vurgulanır (MainWindow.SetActiveMenu). AYARLAR ve ÜRETİM
             sayfalarında sağda dikey alt menü vardır (Pages/SectionPage). -->
        <Border Grid.Row="1"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="MenuPanel"
                            Grid.Column="0"
                            Orientation="Horizontal">
                    <Button x:Name="MenuOtomatikButton"
                            CommandParameter="Otomatik"
                            Style="{StaticResource TopMenuButtonStyle}"
                            Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource MenuIconPathStyle}" Data="M20,12 A8,8 0 1 1 17.66,6.34 M17.9,2.6 L17.66,6.34 L13.9,6.1"/>
                                    <Path Style="{StaticResource MenuIconPathStyle}" Data="M10,8.5 L15.5,12 L10,15.5 Z" StrokeThickness="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="OTOMATİK" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="MenuAyarlarButton"
                            CommandParameter="Ayarlar"
                            Style="{StaticResource TopMenuButtonStyle}"
                            Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource MenuIconPathStyle}" Data="M4,6 H7 M11,6 H20 M7,6 A2,2 0 1 0 11,6 A2,2 0 1 0 7,6 Z M4,12 H13 M17,12 H20 M13,12 A2,2 0 1 0 17,12 A2,2 0 1 0 13,12 Z M4,18 H5 M9,18 H20 M5,18 A2,2 0 1 0 9,18 A2,2 0 1 0 5,18 Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="AYARLAR" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="MenuUretimButton"
                            CommandParameter="Uretim"
                            Style="{StaticResource TopMenuButtonStyle}"
                            Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource MenuIconPathStyle}" Data="M21,12 A9,9 0 1 1 3,12 A9,9 0 1 1 21,12 Z M17,12 A5,5 0 1 1 7,12 A5,5 0 1 1 17,12 Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="ÜRETİM" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="MenuArizalarButton"
                            CommandParameter="Arizalar"
                            Style="{StaticResource TopMenuButtonStyle}"
                            Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource MenuIconPathStyle}" Data="M18,16 V11 A6,6 0 0 0 6,11 V16 L4,18 H20 Z M10,21 H14 M12,3 V5"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="ARIZALAR" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- GENEL: yalnızca simge (Gelişmiş Ayarlar, Servis) -->
                <Button x:Name="MenuGenelButton"
                        Grid.Column="1"
                        CommandParameter="Genel"
                        ToolTip="Genel"
                        AutomationProperties.Name="Genel"
                        Style="{StaticResource TopMenuButtonStyle}"
                        MinWidth="0"
                        Width="64"
                        Padding="0"
                        Click="MenuButton_Click">
                    <Viewbox Width="26" Height="26">
                        <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource MenuIconPathStyle}" Data="M19.45,10.49 L22.11,10.68 L22.11,13.32 L19.45,13.51 L18.33,16.20 L20.09,18.22 L18.22,20.09 L16.20,18.33 L13.51,19.45 L13.32,22.11 L10.68,22.11 L10.49,19.45 L7.80,18.33 L5.78,20.09 L3.91,18.22 L5.67,16.20 L4.55,13.51 L1.89,13.32 L1.89,10.68 L4.55,10.49 L5.67,7.80 L3.91,5.78 L5.78,3.91 L7.80,5.67 L10.49,4.55 L10.68,1.89 L13.32,1.89 L13.51,4.55 L16.20,5.67 L18.22,3.91 L20.09,5.78 L18.33,7.80 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <!-- ALT EKRANLAR -->
        <!-- İçerik alanı: dikey boşluk 14 px. -->
        <Grid Grid.Row="2" Margin="20,14">
            <Frame x:Name="MainFrame"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"/>
        </Grid>

        <!-- ALT DURUM ÇUBUĞU -->
        <Border Grid.Row="3"
                Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <!-- Sol (*): sistem mesajı; aktif arıza varken onun yerine
                 arıza açıklamaları saniyede bir sırayla gösterilir.
                 Sağ (Auto): PLC durumu, her zaman sağa sabit. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBarMessageText"
                               Text="Sistem hazır"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <!-- Arıza akışı: [ARIZA 2/3]  [12] Arıza açıklaması.
                         Dokununca Aktif Alarmlar penceresi açılır. -->
                    <DockPanel x:Name="AlarmTickerPanel"
                               Background="Transparent"
                               Cursor="Hand"
                               MouseLeftButtonUp="MachineStateCard_MouseLeftButtonUp"
                               Visibility="Collapsed"
                               LastChildFill="True">
                        <Border DockPanel.Dock="Left"
                                Background="{DynamicResource ErrorColor}"
                                CornerRadius="3"
                                Padding="6,1"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="AlarmTickerBadge"
                                       Text="ARIZA"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                        <TextBlock x:Name="AlarmTickerText"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ErrorColor}"/>
                    </DockPanel>
                </Grid>

                <!-- PLC durumu. Dokununca uygulama kapanır (tam ekran HMI'da
                     başlık çubuğu olmadığı için çıkış buradan yapılır).
                     Background="Transparent": tüm alan dokunmaya duyarlı. -->
                <StackPanel x:Name="StatusBarPlcPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="24,0,0,0"
                            Background="Transparent"
                            Cursor="Hand"
                            ToolTip="Uygulamayı kapat"
                            MouseLeftButtonUp="StatusBarPlcPanel_MouseLeftButtonUp">
                    <Ellipse x:Name="StatusBarPlcDot"
                             Width="8"
                             Height="8"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource WarningColor}"/>
                    <TextBlock x:Name="StatusBarPlcText"
                               Text="PLC: Bağlantı bekleniyor"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryText}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
