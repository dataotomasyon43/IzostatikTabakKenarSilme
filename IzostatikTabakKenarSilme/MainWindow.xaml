<Window x:Class="IzostatikTabakKenarSilme.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İzostatik Tabak Kenar Silme"
        Height="800"
        Width="1280"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource PrimaryText}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ÜST SABİT HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                    
                <Grid Grid.Column="0">
                    <Image x:Name="Logo" HorizontalAlignment="Left" Width="150" Height="130" Source="/WhatsApp Image 2025-01-02 at 19.45.08-Photoroom.png"  />
                </Grid>

                <StackPanel Orientation="Vertical"
                            VerticalAlignment="Center" Grid.Column="1">
                    <TextBlock Text="İZOSTATİK TABAK KENAR SİLME"
                               FontSize="19"
                               FontWeight="Bold"/>
                    <TextBlock Text="Operatör Paneli"
                               Foreground="{DynamicResource SecondaryText}"
                               FontSize="12"
                               Margin="0,3,0,0"/>
                </StackPanel>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="60"/>
                        </Grid.RowDefinitions>
               <WrapPanel Grid.Row="0"
                           VerticalAlignment="Center">
                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource PanelBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,7"
                            Margin="4">
                        <StackPanel>
                            <TextBlock Text="PLC BAĞLANTISI"
                                       FontSize="10"
                                       Foreground="{DynamicResource SecondaryText}"/>
                            <TextBlock x:Name="PlcStatusText"
                                       Text="● Bağlantı bekleniyor"
                                       Foreground="{DynamicResource WarningColor}"
                                       FontWeight="Bold"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource PanelBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,7"
                            Margin="4">
                        <StackPanel>
                            <TextBlock Text="ÇALIŞMA MODU"
                                       FontSize="10"
                                       Foreground="{DynamicResource SecondaryText}"/>
                            <TextBlock x:Name="ModeText"
                                       Text="-"
                                       FontWeight="Bold"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                        <Button x:Name="ThemeButton" Style="{DynamicResource MenuButtonStyle}"
                                
                            Content="☀"
                            Padding="12,9"
                            Width="60"
                            Margin="8,4,4,4"
                            Click="ThemeButton_Click" FontSize="24" HorizontalAlignment="Center"/>
                </WrapPanel>

                <!-- ÇALIŞMA MODU BUTONLARI: tıklanınca Mode tag'ine
                     CommandParameter'daki değer yazılır.
                     0 Kapalı, 1 Güvenli, 2 Manuel, 3 Otomatik -->
                <UniformGrid x:Name="ModeButtonsPanel"
                             Grid.Row="1"
                             Rows="1"
                             Columns="4"
                             VerticalAlignment="Center">
                    <Button x:Name="ModeKapaliButton"
                            Content="KAPALI"
                            CommandParameter="0"
                            Style="{StaticResource ActionButtonStyle}"
                            MinWidth="100"
                            Height="52"
                            Click="ModeButton_Click"/>
                    <Button x:Name="ModeGuvenliButton"
                            Content="GÜVENLİ"
                            CommandParameter="1"
                            Style="{StaticResource ActionButtonStyle}"
                            MinWidth="100"
                            Height="52"
                            Click="ModeButton_Click"/>
                    <Button x:Name="ModeManuelButton"
                            Content="MANUEL"
                            CommandParameter="2"
                            Style="{StaticResource ActionButtonStyle}"
                            MinWidth="100"
                            Height="52"
                            Click="ModeButton_Click"/>
                    <Button x:Name="ModeOtomatikButton"
                            Content="OTOMATİK"
                            CommandParameter="3"
                            Style="{StaticResource ActionButtonStyle}"
                            MinWidth="100"
                            Height="52"
                            Click="ModeButton_Click"/>
                </UniformGrid>
                    </Grid>
            </Grid>
        </Border>

        <!-- MENÜ VE ALT EKRANLAR -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="0,0,1,0"
                    Padding="10">

                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="MENÜ"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryText}"
                               Margin="8,8,8,14"/>

                    <StackPanel>
                        <Button Content="⌂   Ana Ekran"
                                Tag="Home"
                                Style="{DynamicResource MenuButtonStyle}"
                                Click="MenuButton_Click"/>

                        <Button Content="▣   Tabak Yükle"
                                Tag="TabakYukle"
                                Style="{DynamicResource MenuButtonStyle}"
                                Click="MenuButton_Click"/>

                        <Button Content="◉   Canlı İzleme"
                                Tag="CanliIzleme"
                                Style="{DynamicResource MenuButtonStyle}"
                                Click="MenuButton_Click"/>

                        <Button Content="▤   Reçeteler"
                                Tag="Receteler"
                                Style="{DynamicResource MenuButtonStyle}"
                                Click="MenuButton_Click"/>

                        <Button Content="⚙   Ayarlar"
                                Tag="Ayarlar"
                                Style="{DynamicResource MenuButtonStyle}"
                                Click="MenuButton_Click"/>

                        <Button Content="⚠   Alarm Geçmişi"
                                Tag="AlarmGecmisi"
                                Style="{DynamicResource MenuButtonStyle}"
                                Click="MenuButton_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ALT EKRANLAR -->
            <Grid Grid.Column="1" Margin="20">
                <Frame x:Name="MainFrame"
           NavigationUIVisibility="Hidden"
           Background="Transparent"/>
            </Grid>
        </Grid>

        <!-- ALT DURUM ÇUBUĞU -->
            <Border Grid.Row="2"
                Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
                <DockPanel>
                    <TextBlock x:Name="StatusBarMessageText"
                           Text="Sistem hazır"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SecondaryText}"/>
                    <TextBlock x:Name="StatusBarPlcText"
                           DockPanel.Dock="Right"
                           Text="PLC: Bağlantı bekleniyor"
                           Foreground="{DynamicResource SecondaryText}"/>
                </DockPanel>
            </Border>
        </Grid>
</Window>
