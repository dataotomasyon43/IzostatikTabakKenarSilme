<UserControl x:Class="IzostatikTabakKenarSilme.Controls.ParameterField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="64">

    <!-- Bir ayar satırı: ad · değer kutusu · birim.
         Değer kutusuna basınca sayı klavyesi açılır. -->
    <UserControl.Resources>
        <Style x:Key="ValueBoxStyle" TargetType="{x:Type Button}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="Frame"
                                    Background="{DynamicResource AppBackground}"
                                    BorderBrush="{DynamicResource PanelBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"/>
                            <Border x:Name="Tint"
                                    Background="{DynamicResource AccentColor}"
                                    CornerRadius="6"
                                    Opacity="0"/>
                            <ContentPresenter Margin="14,0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="56"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="LabelText"
                   FontSize="17"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>

        <Button x:Name="ValueButton"
                Grid.Column="1"
                Height="54"
                Style="{StaticResource ValueBoxStyle}"
                Click="ValueButton_Click">
            <TextBlock x:Name="ValueText"
                       Text="—"
                       FontSize="26"
                       FontFamily="Consolas"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryText}"/>
        </Button>

        <TextBlock x:Name="UnitText"
                   Grid.Column="2"
                   Margin="12,0,0,0"
                   FontSize="16"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SecondaryText}"/>
    </Grid>
</UserControl>
