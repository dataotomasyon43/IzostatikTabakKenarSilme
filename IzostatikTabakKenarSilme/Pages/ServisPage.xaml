<Page x:Class="IzostatikTabakKenarSilme.Pages.ServisPage"
      Foreground="{DynamicResource PrimaryText}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="538" d:DesignWidth="1024"
      Background="Transparent"
      Title="ServisPage">

    <!-- GENEL > Servis: bakım / arıza arama ekranı. Yalnız okur, PLC'ye
         hiçbir şey yazmaz. Dört görünüm: girişler, çıkışlar, eksenler,
         sistem. Yalnız açık görünümün değerleri okunur. Lambalar ve satırlar
         koddan oluşturulur. -->
    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="TabStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CommandButtonStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
        </Style>
        <Style x:Key="ActionStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CommandButtonStyle}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="ThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border Background="{DynamicResource PanelBorder}" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık + görünüm seçimi -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Servis" FontSize="25" FontWeight="Bold" VerticalAlignment="Bottom"/>
                <TextBlock x:Name="SubtitleText" Margin="16,0,0,4" VerticalAlignment="Bottom"
                           Foreground="{DynamicResource SecondaryText}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="InputsTab" Content="GİRİŞLER" Style="{StaticResource TabStyle}" Click="Tab_Click"/>
                <Button x:Name="OutputsTab" Content="ÇIKIŞLAR" Style="{StaticResource TabStyle}" Click="Tab_Click"/>
                <Button x:Name="AxesTab" Content="EKSENLER" Style="{StaticResource TabStyle}" Click="Tab_Click"/>
                <Button x:Name="SystemTab" Content="SİSTEM" Style="{StaticResource TabStyle}" Click="Tab_Click"/>
            </StackPanel>
        </Grid>

        <!-- Girişler / çıkışlar: dört sütun kart, gerekirse kaydırılır -->
        <ScrollViewer x:Name="IoView" Grid.Row="1"
                      PanningMode="VerticalOnly"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      ManipulationBoundaryFeedback="Scroll_ManipulationBoundaryFeedback">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ThinScrollBarStyle}"/>
            </ScrollViewer.Resources>
            <Grid x:Name="IoColumns" Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="IoCol0" Grid.Column="0"/>
                <StackPanel x:Name="IoCol1" Grid.Column="2"/>
                <StackPanel x:Name="IoCol2" Grid.Column="4"/>
                <StackPanel x:Name="IoCol3" Grid.Column="6"/>
            </Grid>
        </ScrollViewer>

        <!-- Eksenler -->
        <Grid x:Name="AxesView" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel x:Name="AxesLeft">
                    <TextBlock Text="BOMSELER (°)" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"
                               Foreground="{DynamicResource SecondaryText}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel x:Name="AxesRight">
                    <TextBlock Text="MODÜLLER VE TRANSFERLER (mm)" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"
                               Foreground="{DynamicResource SecondaryText}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Sistem -->
        <Grid x:Name="SystemView" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="SİSTEM BİLGİSİ" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"
                               Foreground="{DynamicResource SecondaryText}"/>
                    <Grid x:Name="SystemInfoGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="2">
                <Button Content="LOGLARI USB'YE KOPYALA" Style="{StaticResource ActionStyle}"
                        Click="CopyLogs_Click"/>
                <Button Content="TAG OKUMA TESTİ" Style="{StaticResource ActionStyle}"
                        Click="TagTest_Click"/>
                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"
                           Text="Loglar ve alarm geçmişi takılı USB belleğe IzostatikLoglar klasörüne kopyalanır. Tag okuma testi, PLC'de bir değişkenin okunup okunamadığını denemek içindir."/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="PageStatusText"
                   Grid.Row="2"
                   Margin="0,6,0,0"
                   FontSize="13"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource SecondaryText}"/>
    </Grid>
</Page>
