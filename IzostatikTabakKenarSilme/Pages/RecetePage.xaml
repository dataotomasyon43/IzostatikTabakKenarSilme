<Page x:Class="IzostatikTabakKenarSilme.Pages.RecetePage"
      Foreground="{DynamicResource PrimaryText}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="538" d:DesignWidth="1024"
      Background="Transparent"
      Title="RecetePage">

    <!-- ÜRETİM > Reçete: tabak formu + tabağa bağlı ayarların adlı kaydı.
         Solda reçete listesi, sağda reçete / PLC karşılaştırması ve yükleme. -->
    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
        </Style>

        <!-- Liste satırı (Focusable açık kalmalı: tıklamada seçim için) -->
        <Style x:Key="ItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid Margin="0,0,0,4" Background="Transparent">
                            <Border x:Name="Frame"
                                    Background="{DynamicResource AppBackground}"
                                    BorderBrush="{DynamicResource PanelBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"/>
                            <Border x:Name="Tint"
                                    Background="{DynamicResource AccentColor}"
                                    CornerRadius="5"
                                    Opacity="0"/>
                            <Border x:Name="Bar"
                                    Background="{DynamicResource AccentColor}"
                                    Width="4"
                                    HorizontalAlignment="Left"
                                    CornerRadius="5,0,0,5"
                                    Visibility="Collapsed"/>
                            <ContentPresenter Margin="14,8,10,8"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.12"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border Background="{DynamicResource PanelBorder}" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık + etkin reçete -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Reçete" FontSize="25" FontWeight="Bold" VerticalAlignment="Bottom"/>
            <TextBlock Grid.Column="1"
                       Text="Tabak formu ve tabağa bağlı ayarları kaydet, tek seferde yükle"
                       Margin="16,0,0,4" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource SecondaryText}"/>
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="12,5" VerticalAlignment="Bottom">
                <StackPanel>
                    <TextBlock Text="ETKİN REÇETE" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryText}"/>
                    <TextBlock x:Name="ActiveText" Text="—" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="ActiveDiffText" FontSize="11" Visibility="Collapsed"
                               Foreground="{DynamicResource WarningColor}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= REÇETE LİSTESİ ================= -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ListTitleText" Text="REÇETELER"
                               Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>

                    <ListBox x:Name="ReceteList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource PrimaryText}"
                             ItemContainerStyle="{StaticResource ItemStyle}"
                             SelectionChanged="ReceteList_SelectionChanged"
                             ManipulationBoundaryFeedback="Scroll_ManipulationBoundaryFeedback">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ThinScrollBarStyle}"/>
                        </ListBox.Resources>
                        <ListBox.Template>
                            <ControlTemplate TargetType="{x:Type ListBox}">
                                <ScrollViewer PanningMode="VerticalOnly"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              Focusable="False">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource SecondaryText}">
                                        <Run Text="{Binding FormName, TargetNullValue='(form yok)', Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding ModifiedText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyListText" Grid.Row="1"
                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                               Margin="10" FontSize="13" Visibility="Collapsed"
                               Foreground="{DynamicResource SecondaryText}"
                               Text="Henüz reçete yok. Makine bir tabak için ayarlıyken YENİ ile kaydedin."/>

                    <UniformGrid Grid.Row="2" Columns="3" Margin="-4,8,-4,0">
                        <Button x:Name="NewButton" Content="YENİ" Style="{StaticResource ActionButtonStyle}"
                                Padding="4,0" Click="NewButton_Click"/>
                        <Button x:Name="SaveButton" Content="KAYDET" Style="{StaticResource ActionButtonStyle}"
                                Padding="4,0" Click="SaveButton_Click"/>
                        <Button x:Name="DeleteButton" Content="SİL" Style="{StaticResource ActionButtonStyle}"
                                Padding="4,0" Click="DeleteButton_Click"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- ================= REÇETE DETAYI ================= -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Reçete adı, formu, form önizlemesi -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ReceteNameText" Text="Reçete seçilmedi" FontSize="20" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="FormInfoText" FontSize="13" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SecondaryText}"/>
                            <TextBlock x:Name="DiffText" FontSize="13" FontWeight="Bold" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="96" Height="80"
                                Background="{DynamicResource AppBackground}"
                                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="5">
                            <Canvas x:Name="FormCanvas" ClipToBounds="True" Margin="6"/>
                        </Border>
                    </Grid>

                    <!-- Tablo başlığı -->
                    <Grid Grid.Row="1" Margin="0,0,14,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="AYAR" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Grid.Column="1" Text="REÇETE" Style="{StaticResource CardTitleStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="PLC (ŞU AN)" Style="{StaticResource CardTitleStyle}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Karşılaştırma tablosu (satırlar koddan) -->
                    <ScrollViewer x:Name="TableScroll" Grid.Row="2"
                                  PanningMode="VerticalOnly"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ManipulationBoundaryFeedback="Scroll_ManipulationBoundaryFeedback">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ThinScrollBarStyle}"/>
                        </ScrollViewer.Resources>
                        <StackPanel x:Name="TablePanel" Margin="0,0,8,0"/>
                    </ScrollViewer>

                    <!-- Yükle -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="VerdictBorder" CornerRadius="5" Padding="10,6" BorderThickness="1"
                                BorderBrush="{DynamicResource PanelBorder}" VerticalAlignment="Center">
                            <TextBlock x:Name="VerdictText" Text="Reçete seçilmedi" FontSize="13"
                                       FontWeight="Bold" TextWrapping="Wrap"/>
                        </Border>
                        <Button x:Name="LoadButton" Grid.Column="2" Height="60"
                                Style="{StaticResource CommandButtonStyle}"
                                Foreground="{DynamicResource OkColor}"
                                IsEnabled="False" Click="LoadButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource ButtonIconPathStyle}"
                                              Data="M12,16 V4 M7,9 L12,4 L17,9 M5,20 H19"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="REÇETEYİ YÜKLE" FontSize="17" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="PageStatusText" Grid.Row="2" Margin="0,6,0,0" FontSize="13"
                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryText}"/>
    </Grid>
</Page>
