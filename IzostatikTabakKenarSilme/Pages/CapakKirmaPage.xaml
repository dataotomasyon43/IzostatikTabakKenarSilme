<Page x:Class="IzostatikTabakKenarSilme.Pages.CapakKirmaPage"
      Foreground="{DynamicResource PrimaryText}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:IzostatikTabakKenarSilme.Controls"
      mc:Ignorable="d"
      d:DesignHeight="538" d:DesignWidth="1024"
      Background="Transparent"
      Title="CapakKirmaPage">

    <!-- AYARLAR > Çapak Kırma (istasyon 2): bomse ayarları (Bomse 2),
         modül ayarları, TEACH, makine görseli ve jog butonları. -->
    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="{x:Type controls:ParameterField}">
            <Setter Property="Height" Value="47"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="ManualButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CommandButtonStyle}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <!-- Basılı tutma butonları turuncu -->
        <Style x:Key="PushButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ManualButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Çapak Kırma"
                       FontSize="25"
                       FontWeight="Bold"
                       VerticalAlignment="Bottom"/>
            <TextBlock Text="Bomse ve modül ayarları, manuel kumanda"
                       Margin="16,0,0,4"
                       VerticalAlignment="Bottom"
                       Foreground="{DynamicResource SecondaryText}"/>
        </StackPanel>

        <!-- BOMSE | MODÜL | GÖRSEL (görsel satır boyu, dikey) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- ================= BOMSE ================= -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="BOMSE" Style="{StaticResource CardTitleStyle}"/>

                    <controls:ParameterField x:Name="BomseBasPozField"
                                             Label="Bomse Başlama Pos" Unit="°" Decimals="1" Min="0" Max="360"
                                             ValueWidth="110" UnitWidth="36" ValueFontSize="24"/>
                    <controls:ParameterField x:Name="BomseAktPozField"
                                             Label="Bomse Aktüel Pos" Unit="°" Decimals="1"
                                             ValueWidth="110" UnitWidth="36" ValueFontSize="24"
                                             IsReadOnly="True"/>
                    <controls:ParameterField x:Name="BitisAciField"
                                             Label="Bitiş Ek Açı" Unit="°" Decimals="1" Min="0" Max="360"
                                             ValueWidth="110" UnitWidth="36" ValueFontSize="24"/>
                    <controls:ParameterField x:Name="GeriCekilmeAciField"
                                             Label="Modül Geri Çekilme Açısı" Unit="°" Decimals="1" Min="0" Max="360"
                                             ValueWidth="110" UnitWidth="36" ValueFontSize="24"/>
                    <controls:ParameterField x:Name="TurSureField"
                                             Label="Tur Süresi" Unit="s" Decimals="1" Min="0" Max="9999"
                                             ValueWidth="110" UnitWidth="36" ValueFontSize="24"/>

                    <!-- Tur sayısı + bomse dönüş yönü ("geri", kalıcı) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="86"/>
                        </Grid.ColumnDefinitions>
                        <controls:ParameterField x:Name="TurSayiField"
                                                 Label="Tur Sayısı" Unit="adet" Decimals="0" Min="0" Max="9999"
                                                 ValueWidth="80" UnitWidth="44" ValueFontSize="24"/>
                        <!-- HMI_Bomse2Yon: açıkken bomse geri yönde döner -->
                        <controls:PlcToggleButton x:Name="GeriYonButton" Grid.Column="2"
                                                  Margin="0,5"
                                                  Content="GERİ"
                                                  Description="Çapak Kırma Bomse Geri Yön"
                                                  Style="{StaticResource ManualButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= MODÜL ================= -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="MODÜL" Style="{StaticResource CardTitleStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <controls:ParameterField x:Name="ModHizField" Grid.Row="0"
                                                 Label="Modül Hızı" Unit="%" Decimals="0" Min="0" Max="9999"
                                                 ValueWidth="110" UnitWidth="40" ValueFontSize="24"/>
                        <controls:ParameterField x:Name="ModAktPozField" Grid.Row="1"
                                                 Label="Aktüel Poz" Unit="mm" Decimals="2"
                                                 ValueWidth="110" UnitWidth="40" ValueFontSize="24"
                                                 IsReadOnly="True"/>
                        <controls:ParameterField x:Name="ModBasPozField" Grid.Row="2"
                                                 Label="Başlama Poz" Unit="mm" Decimals="2" Min="0" Max="9999"
                                                 ValueWidth="110" UnitWidth="40" ValueFontSize="24"/>
                        <!-- HMI_Cpk_BasPoz_Ogren: basılı tutma -->
                        <controls:PlcPushButton x:Name="TeachButton" Grid.Row="2" Grid.Column="2"
                                                Margin="0,5"
                                                Content="TEACH"
                                                Description="Çapak Kırma Başlama Poz Teach"
                                                Style="{StaticResource PushButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= GÖRSEL =================
                 Örnek görsel: Assets\CapakKirma.png aynı adla değiştirilebilir. -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="10">
                <Image Source="/Assets/CapakKirma.png"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </Grid>

        <!-- ================= JOG BUTONLARI =================
             Basılı tuttukça çalışır (bas TRUE, bırak FALSE). -->
        <UniformGrid Grid.Row="2" Rows="1" Columns="4" Margin="-4,10,-4,0" Height="68">
            <controls:PlcPushButton x:Name="BomseIleriButton" Content="BOMSE İLERİ DÖN"
                                    Description="Çapak Kırma Bomse İleri Dön" Style="{StaticResource PushButtonStyle}"/>
            <controls:PlcPushButton x:Name="BomseGeriButton" Content="BOMSE GERİ DÖN"
                                    Description="Çapak Kırma Bomse Geri Dön" Style="{StaticResource PushButtonStyle}"/>
            <controls:PlcPushButton x:Name="ModulIleriButton" Content="MODÜL İLERİ"
                                    Description="Çapak Kırma Modül İleri" Style="{StaticResource PushButtonStyle}"/>
            <controls:PlcPushButton x:Name="ModulGeriButton" Content="MODÜL GERİ"
                                    Description="Çapak Kırma Modül Geri" Style="{StaticResource PushButtonStyle}"/>
        </UniformGrid>

        <!-- Sayfa durumu -->
        <TextBlock x:Name="PageStatusText"
                   Grid.Row="3"
                   Margin="0,6,0,0"
                   FontSize="13"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource SecondaryText}"
                   Text="Turuncu butonlar basılı tuttukça çalışır. GERİ: bir basışta açılır, bir basışta kapanır."/>
    </Grid>
</Page>
