<Page x:Class="IzostatikTabakKenarSilme.Pages.DonerTablaPage"
      Foreground="{DynamicResource PrimaryText}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:IzostatikTabakKenarSilme.Controls"
      mc:Ignorable="d"
      d:DesignHeight="538" d:DesignWidth="1024"
      Background="Transparent"
      Title="DonerTablaPage">

    <!-- AYARLAR > Döner Tabla: tabla yerinde göstergesi, göbek hızı,
         makine görseli ve manuel butonlar. -->
    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,12"/>
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="LampStyle" TargetType="{x:Type Ellipse}">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource PanelBorder}"/>
        </Style>
        <Style TargetType="{x:Type controls:ParameterField}">
            <Setter Property="Height" Value="60"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style x:Key="ManualButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CommandButtonStyle}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <!-- Basılı tutma butonları turuncu -->
        <Style x:Key="PushButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ManualButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Döner Tabla"
                       FontSize="25"
                       FontWeight="Bold"
                       VerticalAlignment="Bottom"/>
            <TextBlock Text="Göbek hızı, tabla baskıları ve manuel adım"
                       Margin="16,0,0,4"
                       VerticalAlignment="Bottom"
                       Foreground="{DynamicResource SecondaryText}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- ================= DURUM ================= -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="DURUM" Style="{StaticResource CardTitleStyle}"/>

                        <!-- I_Tabla_Yerinde -->
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <Ellipse x:Name="TablaYerindeLamp" Style="{StaticResource LampStyle}"/>
                            <TextBlock Text="Tabla Yerinde 1" FontSize="17" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= AYARLAR ================= -->
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="AYARLAR" Style="{StaticResource CardTitleStyle}"/>

                        <!-- HMI_Doner_Tabla_Hiz (INT, %) -->
                        <controls:ParameterField x:Name="GobekHizField"
                                                 Label="Göbek Hızı" Unit="%" Decimals="0" Min="0" Max="99"
                                                 ValueWidth="110" UnitWidth="40"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= GÖRSEL =================
                 Örnek görsel: Assets\DonerTabla.png aynı adla değiştirilebilir. -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                <Image Source="/Assets/DonerTabla.png"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </Grid>

        <!-- ================= MANUEL BUTONLAR =================
             Turuncu: basılı tuttukça (bas TRUE, bırak FALSE).
             Diğerleri kalıcı: bir basış açar, bir basış kapatır (açıkken yeşil). -->
        <UniformGrid Grid.Row="2" Rows="1" Columns="4" Margin="-4,10,-4,0" Height="72">
            <controls:PlcPushButton x:Name="GobekAdimButton" Content="GÖBEK ADIM"
                                    Description="Göbek Adım" Style="{StaticResource PushButtonStyle}"/>
            <controls:PlcToggleButton x:Name="Baski1Button" Content="BASKI-1 AŞAĞI"
                                      Description="Baskı-1 Aşağı" Style="{StaticResource ManualButtonStyle}"/>
            <controls:PlcToggleButton x:Name="Baski2Button" Content="BASKI-2 AŞAĞI"
                                      Description="Baskı-2 Aşağı" Style="{StaticResource ManualButtonStyle}"/>
            <controls:PlcToggleButton x:Name="Baski3Button" Content="BASKI-3 AŞAĞI"
                                      Description="Baskı-3 Aşağı" Style="{StaticResource ManualButtonStyle}"/>
        </UniformGrid>

        <!-- Sayfa durumu -->
        <TextBlock x:Name="PageStatusText"
                   Grid.Row="3"
                   Margin="0,6,0,0"
                   FontSize="13"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource SecondaryText}"
                   Text="Turuncu buton basılı tuttukça çalışır; diğerleri bir basışta açılır, bir basışta kapanır."/>
    </Grid>
</Page>
