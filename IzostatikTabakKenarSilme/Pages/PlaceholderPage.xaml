<Page x:Class="IzostatikTabakKenarSilme.Pages.PlaceholderPage"
      Foreground="{DynamicResource PrimaryText}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="526" d:DesignWidth="1240"
      Background="Transparent"
      Title="PlaceholderPage">

    <!-- Henüz içeriği yapılmamış sayfalar için başlık + not. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText"
                       FontSize="25"
                       FontWeight="Bold"/>
            <TextBlock x:Name="SubtitleText"
                       Margin="0,5,0,0"
                       Foreground="{DynamicResource SecondaryText}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="18,14">
            <TextBlock Text="Bu sayfa hazırlanıyor."
                       Foreground="{DynamicResource SecondaryText}"/>
        </Border>
    </Grid>
</Page>
