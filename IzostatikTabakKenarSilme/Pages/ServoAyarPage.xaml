<Page x:Class="IzostatikTabakKenarSilme.Pages.ServoAyarPage"
      Foreground="{DynamicResource PrimaryText}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:IzostatikTabakKenarSilme.Controls"
      mc:Ignorable="d"
      d:DesignHeight="538" d:DesignWidth="1024"
      Background="Transparent"
      Title="ServoAyarPage">

    <!-- ÜRETİM > Servo: tabak formuna bağlı bomse hız ayarları (oranlı mod,
         köşe hızı) ve modül geri mesafeleri; istasyon grubu başına bir kart.
         Kartlar koddan oluşturulur. -->
    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>
        <Style TargetType="{x:Type controls:ParameterField}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="ToggleStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CommandButtonStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Servo"
                       FontSize="25"
                       FontWeight="Bold"
                       VerticalAlignment="Bottom"/>
            <TextBlock Text="Forma göre bomse hızı (oranlı mod, köşe hızı) ve modül geri mesafeleri"
                       Margin="16,0,0,4"
                       VerticalAlignment="Bottom"
                       Foreground="{DynamicResource SecondaryText}"/>
        </StackPanel>

        <UniformGrid x:Name="CardsPanel" Grid.Row="1" Columns="3" Rows="1" Margin="-6,0"/>

        <TextBlock x:Name="PageStatusText"
                   Grid.Row="2"
                   Margin="0,8,0,0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryText}"
                   Text="Oranlı mod: bomse hızı tabağın şekline göre değişir; köşede Köşe Hızı %, düz kenarda %100. Köşeler Hızlı açıkken tersi. Geri dönüş pozisyonu = kurs + başlama poz + geri mesafe (PLC hesaplar)."/>
    </Grid>
</Page>
