<Window x:Class="IzostatikTabakKenarSilme.Windows.UsbFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="USB'den Form Ekle"
        Width="980"
        Height="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource PrimaryText}">

    <!-- Takılı USB belleklerdeki tabak formu dosyalarını (.xlsx, .csv; .xls
         uyarıyla) listeler. Seçilen dosyanın şekli sağda önizlenir; YÜKLE ile
         kütüphaneye eklenir. ELLE ARA dosya yöneticisini açar. -->
    <Window.Resources>
        <!-- Focusable kapatılmamalı: ListBoxItem tıklamada önce odak alır,
             odak alamazsa seçim yapmaz. Kesikli odak çerçevesi gizlenir. -->
        <Style x:Key="FileItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid Margin="0,0,0,4" Background="Transparent">
                            <Border x:Name="Frame"
                                    Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource PanelBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"/>
                            <Border x:Name="Tint"
                                    Background="{DynamicResource AccentColor}"
                                    CornerRadius="5"
                                    Opacity="0"/>
                            <Border x:Name="Bar"
                                    Background="{DynamicResource AccentColor}"
                                    Width="4"
                                    HorizontalAlignment="Left"
                                    CornerRadius="5,0,0,5"
                                    Visibility="Collapsed"/>
                            <ContentPresenter Margin="14,9,12,9"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.12"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border Background="{DynamicResource PanelBorder}" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BottomButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Height" Value="58"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource AccentColor}" BorderThickness="2">
        <Grid Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık + durum -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="USB'den Form Ekle" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="ScanStatusText" Grid.Column="1" Margin="16,0,12,0" FontSize="13"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SecondaryText}"/>
                <Button Grid.Column="2" Content="YENİLE" Height="42" MinWidth="110" Focusable="False"
                        Style="{StaticResource ActionButtonStyle}" Click="Refresh_Click"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Dosya listesi -->
                <Grid>
                    <ListBox x:Name="FileList"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource PrimaryText}"
                             ItemContainerStyle="{StaticResource FileItemStyle}"
                             SelectionChanged="FileList_SelectionChanged"
                             MouseDoubleClick="FileList_MouseDoubleClick"
                             ManipulationBoundaryFeedback="FileList_ManipulationBoundaryFeedback">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ThinScrollBarStyle}"/>
                        </ListBox.Resources>
                        <ListBox.Template>
                            <ControlTemplate TargetType="{x:Type ListBox}">
                                <ScrollViewer PanningMode="VerticalOnly"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              Focusable="False">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileName}" FontSize="16" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Location}" FontSize="12" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SecondaryText}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Margin="10,0,0,0" Padding="8,3" CornerRadius="4"
                                            VerticalAlignment="Center"
                                            Background="{Binding BadgeBrush}"
                                            Visibility="{Binding BadgeVisibility}">
                                        <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="440"
                               FontSize="16"
                               Foreground="{DynamicResource SecondaryText}"/>
                </Grid>

                <!-- Önizleme -->
                <Border Grid.Column="2"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource PanelBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="ÖNİZLEME" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{DynamicResource SecondaryText}"/>
                        <Canvas x:Name="PreviewCanvas" Grid.Row="1" ClipToBounds="True"
                                SizeChanged="PreviewCanvas_SizeChanged"/>
                        <TextBlock x:Name="PreviewHintText" Grid.Row="1"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" FontSize="14"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Text="Listeden bir dosya seçin"/>
                        <TextBlock x:Name="PreviewInfoText" Grid.Row="2" Margin="0,8,0,0"
                                   FontSize="13" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Alt butonlar -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="ELLE ARA" Style="{StaticResource BottomButtonStyle}"
                        Margin="0" Click="Browse_Click"/>
                <Button Grid.Column="2" Content="İPTAL" Style="{StaticResource BottomButtonStyle}"
                        Click="Cancel_Click"/>
                <Button x:Name="LoadButton" Grid.Column="3" Content="YÜKLE" Tag="Active"
                        Style="{StaticResource BottomButtonStyle}" IsEnabled="False"
                        Click="Load_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
