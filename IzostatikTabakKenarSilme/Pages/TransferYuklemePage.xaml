<Page x:Class="IzostatikTabakKenarSilme.Pages.TransferYuklemePage"
      Foreground="{DynamicResource PrimaryText}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:IzostatikTabakKenarSilme.Controls"
      mc:Ignorable="d"
      d:DesignHeight="538" d:DesignWidth="1024"
      Background="Transparent"
      Title="TransferYuklemePage">

    <!-- AYARLAR > Transfer Yükleme (GTR): piston durumları, hız/ivme,
         alma/bırakma pozisyonları, süreler ve manuel butonlar.
         Düzen eski HMI ekranıyla aynı sırada. -->
    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,12"/>
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="LampStyle" TargetType="{x:Type Ellipse}">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource PanelBorder}"/>
        </Style>
        <Style x:Key="LampTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Ayar satırı (kompakt) -->
        <Style TargetType="{x:Type controls:ParameterField}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <!-- Alt butonlar -->
        <Style x:Key="ManualButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CommandButtonStyle}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <!-- Basılı tutma butonları turuncu (eski ekrandaki ÖĞREN gibi) -->
        <Style x:Key="PushButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ManualButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Transfer Yükleme"
                       FontSize="25"
                       FontWeight="Bold"
                       VerticalAlignment="Bottom"/>
            <TextBlock Text="Giriş transferi (GTR) ayarları ve manuel kumanda"
                       Margin="16,0,0,4"
                       VerticalAlignment="Bottom"
                       Foreground="{DynamicResource SecondaryText}"/>
        </StackPanel>

        <!-- Kartlar: solda pistonlar + süreler, ortada hareket, sağda görsel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- ================= PİSTONLAR ================= -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="PİSTONLAR" Style="{StaticResource CardTitleStyle}"/>

                        <UniformGrid Columns="2" Rows="2">
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Ellipse x:Name="Piston1YukaridaLamp" Style="{StaticResource LampStyle}"/>
                                <TextBlock Text="Piston 1 Yukarıda" Style="{StaticResource LampTextStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Ellipse x:Name="Piston2YukaridaLamp" Style="{StaticResource LampStyle}"/>
                                <TextBlock Text="Piston 2 Yukarıda" Style="{StaticResource LampTextStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Ellipse x:Name="Piston1BaskiLamp" Style="{StaticResource LampStyle}"/>
                                <TextBlock Text="Piston 1 Baskı" Style="{StaticResource LampTextStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <Ellipse x:Name="Piston2BaskiLamp" Style="{StaticResource LampStyle}"/>
                                <TextBlock Text="Piston 2 Baskı" Style="{StaticResource LampTextStyle}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ================= SÜRELER ================= -->
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="SÜRELER" Style="{StaticResource CardTitleStyle}"/>

                        <controls:ParameterField x:Name="VakumSureField" FontSize="14"
                                                 Label="Vakum Bekleme Süresi" Unit="s" Decimals="1" Min="0" Max="9999"
                                                 ValueWidth="84" UnitWidth="24" ValueFontSize="22"/>
                        <controls:ParameterField x:Name="UflemeSureField" FontSize="14"
                                                 Label="Üfleme Süresi" Unit="s" Decimals="1" Min="0" Max="9999"
                                                 ValueWidth="84" UnitWidth="24" ValueFontSize="22"/>
                        <controls:ParameterField x:Name="PrestenAlmaSureField" FontSize="14"
                                                 Label="Presten Tabak Alma Süresi" Unit="s" Decimals="1" Min="0" Max="9999"
                                                 ValueWidth="84" UnitWidth="24" ValueFontSize="22"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= HAREKET ================= -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="HAREKET" Style="{StaticResource CardTitleStyle}"/>

                    <!-- Hız / ivme (INT, %) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <controls:ParameterField x:Name="HizBosField" Grid.Row="0" Grid.Column="0"
                                                 Label="Hız Boş" Unit="%" Decimals="0" Min="0" Max="9999"
                                                 ValueWidth="72" UnitWidth="28" ValueFontSize="22"/>
                        <controls:ParameterField x:Name="IvmeBosField" Grid.Row="0" Grid.Column="2"
                                                 Label="İvme Boş" Unit="%" Decimals="0" Min="0" Max="9999"
                                                 ValueWidth="72" UnitWidth="28" ValueFontSize="22"/>
                        <controls:ParameterField x:Name="HizDoluField" Grid.Row="1" Grid.Column="0"
                                                 Label="Hız Dolu" Unit="%" Decimals="0" Min="0" Max="9999"
                                                 ValueWidth="72" UnitWidth="28" ValueFontSize="22"/>
                        <controls:ParameterField x:Name="IvmeDoluField" Grid.Row="1" Grid.Column="2"
                                                 Label="İvme Dolu" Unit="%" Decimals="0" Min="0" Max="9999"
                                                 ValueWidth="72" UnitWidth="28" ValueFontSize="22"/>
                    </Grid>

                    <Border Height="1" Margin="0,6" Background="{DynamicResource PanelBorder}"/>

                    <!-- Pozisyonlar (REAL, mm) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- HMI_GTR_Akt_Poz (yalnız gösterge) -->
                        <controls:ParameterField x:Name="AktPozField" Grid.Row="0"
                                                 Label="Aktüel Poz" Unit="mm" Decimals="2"
                                                 ValueWidth="120" UnitWidth="40" ValueFontSize="24"
                                                 IsReadOnly="True"/>

                        <controls:ParameterField x:Name="AlmaPozField" Grid.Row="1"
                                                 Label="Alma Poz" Unit="mm" Decimals="2" Min="0" Max="9999"
                                                 ValueWidth="120" UnitWidth="40" ValueFontSize="24"/>
                        <controls:PlcPushButton x:Name="AlmaOgrenButton" Grid.Row="1" Grid.Column="2"
                                                Margin="0,5"
                                                Content="ÖĞREN"
                                                Description="GTR Alma Poz Öğren"
                                                Style="{StaticResource PushButtonStyle}"/>

                        <controls:ParameterField x:Name="BirakmaPozField" Grid.Row="2"
                                                 Label="Bırakma Poz" Unit="mm" Decimals="2" Min="0" Max="9999"
                                                 ValueWidth="120" UnitWidth="40" ValueFontSize="24"/>
                        <controls:PlcPushButton x:Name="BirakmaOgrenButton" Grid.Row="2" Grid.Column="2"
                                                Margin="0,5"
                                                Content="ÖĞREN"
                                                Description="GTR Bırakma Poz Öğren"
                                                Style="{StaticResource PushButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= GÖRSEL =================
                 Örnek görsel: Assets\TransferYukleme.png dosyası aynı adla
                 değiştirilerek gerçek makine görseli konur (oran korunur). -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="10">
                <Image Source="/Assets/TransferYukleme.png"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </Grid>

        <!-- ================= MANUEL BUTONLAR =================
             Turuncu: basılı tuttukça (bas TRUE, bırak FALSE).
             Diğerleri kalıcı: bir basış açar, bir basış kapatır (açıkken yeşil). -->
        <UniformGrid Grid.Row="2" Rows="2" Columns="5" Margin="-4,10,-4,0" Height="124">
            <controls:PlcPushButton x:Name="AlmayaGitButton" Content="ALMAYA GİT"
                                    Description="GTR Almaya Git" Style="{StaticResource PushButtonStyle}"/>
            <controls:PlcToggleButton x:Name="Piston2VakumButton" Content="PİSTON 2 VAKUM"
                                      Description="GTR Piston 2 Vakum" Style="{StaticResource ManualButtonStyle}"/>
            <controls:PlcToggleButton x:Name="Piston2UflemeButton" Content="PİSTON 2 ÜFLEME"
                                      Description="GTR Piston 2 Üfleme" Style="{StaticResource ManualButtonStyle}"/>
            <controls:PlcToggleButton x:Name="Piston2AsagiButton" Content="PİSTON 2 AŞAĞI"
                                      Description="GTR Piston 2 Aşağı" Style="{StaticResource ManualButtonStyle}"/>
            <controls:PlcPushButton x:Name="BirakmayaGitButton" Content="BIRAKMAYA GİT"
                                    Description="GTR Bırakmaya Git" Style="{StaticResource PushButtonStyle}"/>

            <controls:PlcPushButton x:Name="KonveyoreButton" Content="KONVEYÖRE"
                                    Description="GTR Konveyöre" Style="{StaticResource PushButtonStyle}"/>
            <controls:PlcToggleButton x:Name="Piston1VakumButton" Content="PİSTON 1 VAKUM"
                                      Description="GTR Piston 1 Vakum" Style="{StaticResource ManualButtonStyle}"/>
            <controls:PlcToggleButton x:Name="Piston1UflemeButton" Content="PİSTON 1 ÜFLEME"
                                      Description="GTR Piston 1 Üfleme" Style="{StaticResource ManualButtonStyle}"/>
            <controls:PlcToggleButton x:Name="Piston1AsagiButton" Content="PİSTON 1 AŞAĞI"
                                      Description="GTR Piston 1 Aşağı" Style="{StaticResource ManualButtonStyle}"/>
            <controls:PlcPushButton x:Name="GobegeButton" Content="GÖBEĞE"
                                    Description="GTR Göbeğe" Style="{StaticResource PushButtonStyle}"/>
        </UniformGrid>

        <!-- Sayfa durumu -->
        <TextBlock x:Name="PageStatusText"
                   Grid.Row="3"
                   Margin="0,6,0,0"
                   FontSize="13"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource SecondaryText}"
                   Text="Turuncu butonlar basılı tuttukça çalışır; diğerleri bir basışta açılır, bir basışta kapanır."/>
    </Grid>
</Page>
