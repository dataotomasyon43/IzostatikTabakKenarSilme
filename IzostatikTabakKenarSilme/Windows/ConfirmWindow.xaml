<Window x:Class="IzostatikTabakKenarSilme.Windows.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onay"
        Width="640"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource PrimaryText}">

    <!-- Dokunmatik onay penceresi (Windows MessageBox yerine). Renk ve simge
         türe göre koddan verilir: soru vurgu rengi, uyarı turuncu, silme
         kırmızı. Büyük butonlar; ESC / Enter da çalışır. -->
    <Border x:Name="Frame" BorderBrush="{DynamicResource AccentColor}" BorderThickness="2">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border x:Name="IconBadge" Width="40" Height="40" CornerRadius="20"
                        Background="{DynamicResource AccentColor}" VerticalAlignment="Center">
                    <TextBlock x:Name="IconText" Text="?" FontSize="24" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" Margin="14,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Mesaj -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,14">
                <TextBlock x:Name="MessageText" FontSize="18" TextWrapping="Wrap" LineHeight="26"/>
            </Border>

            <!-- Butonlar -->
            <UniformGrid Grid.Row="2" Rows="1" Columns="2" Margin="-6,18,-6,0">
                <Button x:Name="NoButton" Height="70" Margin="6" FontSize="20" Focusable="False"
                        Style="{StaticResource ActionButtonStyle}" Click="No_Click"/>
                <Button x:Name="YesButton" Height="70" Margin="6" FontSize="20" Focusable="False"
                        Tag="Active" Style="{StaticResource ActionButtonStyle}" Click="Yes_Click"/>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
