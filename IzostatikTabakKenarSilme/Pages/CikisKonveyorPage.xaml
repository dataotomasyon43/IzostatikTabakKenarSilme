<Page x:Class="IzostatikTabakKenarSilme.Pages.CikisKonveyorPage"
      Foreground="{DynamicResource PrimaryText}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:IzostatikTabakKenarSilme.Controls"
      mc:Ignorable="d"
      d:DesignHeight="538" d:DesignWidth="1024"
      Background="Transparent"
      Title="CikisKonveyorPage">

    <!-- AYARLAR > Çıkış Konveyör: son sensör, konveyör hızı + yön,
         istif adedi, dönme süresi, makine görseli ve KONVEYÖR DÖN. -->
    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,12"/>
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="LampStyle" TargetType="{x:Type Ellipse}">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource PanelBorder}"/>
        </Style>
        <Style TargetType="{x:Type controls:ParameterField}">
            <Setter Property="Height" Value="54"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style x:Key="ManualButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CommandButtonStyle}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="PushButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ManualButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Çıkış Konveyör"
                       FontSize="25"
                       FontWeight="Bold"
                       VerticalAlignment="Bottom"/>
            <TextBlock Text="Konveyör hızı, istif adedi ve manuel çalıştırma"
                       Margin="16,0,0,4"
                       VerticalAlignment="Bottom"
                       Foreground="{DynamicResource SecondaryText}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- ================= KONVEYÖR ================= -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="KONVEYÖR" Style="{StaticResource CardTitleStyle}"/>

                        <!-- I_CikisBandi_SonSens -->
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <Ellipse x:Name="SonSensorLamp" Style="{StaticResource LampStyle}"/>
                            <TextBlock Text="Çıkış Konv Son Sensör" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Hız + yön ("geri", kalıcı) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="86"/>
                            </Grid.ColumnDefinitions>
                            <controls:ParameterField x:Name="HizField"
                                                     Label="Konv Hız" Unit="%" Decimals="0" Min="0" Max="99"
                                                     ValueWidth="100" UnitWidth="34"/>
                            <controls:PlcToggleButton x:Name="YonButton" Grid.Column="2"
                                                      Margin="0,6"
                                                      Content="GERİ"
                                                      Description="Çıkış Konveyör Geri Yön"
                                                      Style="{StaticResource ManualButtonStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= İSTİF ================= -->
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="İSTİF" Style="{StaticResource CardTitleStyle}"/>

                        <!-- HMI_Istif_Akt (gösterge) / HMI_Istif_Adet (hedef) -->
                        <controls:ParameterField x:Name="IstifAktField"
                                                 Label="İstif Adet (Aktüel)" Unit="adet" Decimals="0"
                                                 ValueWidth="100" UnitWidth="50"
                                                 IsReadOnly="True"/>
                        <controls:ParameterField x:Name="IstifAdetField"
                                                 Label="İstif Adet (Hedef)" Unit="adet" Decimals="0" Min="0" Max="9999"
                                                 ValueWidth="100" UnitWidth="50"/>
                        <!-- HMI_Cikis_Konv_T (REAL, s) -->
                        <controls:ParameterField x:Name="DonmeSureField"
                                                 Label="Konveyör Dönme Süresi" Unit="s" Decimals="1" Min="0" Max="9999"
                                                 ValueWidth="100" UnitWidth="50"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= GÖRSEL =================
                 Örnek görsel: Assets\CikisKonveyor.png aynı adla değiştirilebilir. -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10">
                <Image Source="/Assets/CikisKonveyor.png"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </Grid>

        <!-- ================= MANUEL =================
             KONVEYÖR DÖN: basılı tuttukça (bas TRUE, bırak FALSE). -->
        <Grid Grid.Row="2" Margin="-4,10,-4,0" Height="72">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <controls:PlcPushButton x:Name="KonvDonButton" Grid.Column="0"
                                    Content="KONVEYÖR DÖN"
                                    Description="Çıkış Konveyör Dön"
                                    Style="{StaticResource PushButtonStyle}"/>
        </Grid>

        <!-- Sayfa durumu -->
        <TextBlock x:Name="PageStatusText"
                   Grid.Row="3"
                   Margin="0,6,0,0"
                   FontSize="13"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource SecondaryText}"
                   Text="KONVEYÖR DÖN basılı tuttukça çalışır. GERİ: bir basışta açılır, bir basışta kapanır."/>
    </Grid>
</Page>
