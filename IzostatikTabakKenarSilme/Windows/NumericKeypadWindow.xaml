<Window x:Class="IzostatikTabakKenarSilme.Windows.NumericKeypadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Değer Girişi"
        Width="440"
        Height="640"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource PrimaryText}">

    <!-- Dokunmatik sayı girişi: parametre kutusuna basınca açılır.
         TAMAM yalnızca değer aralık içindeyse kabul edilir. -->
    <Window.Resources>
        <Style x:Key="KeyButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource AccentColor}"
            BorderThickness="2">
        <Grid Margin="20,14,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="TitleText"
                           FontSize="20"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CurrentText"
                           Margin="0,4,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryText}"/>
            </StackPanel>

            <!-- Girilen değer -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Height="72"
                    Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ValueText"
                               FontSize="38"
                               FontFamily="Consolas"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="UnitText"
                               Grid.Column="1"
                               FontSize="18"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryText}"/>
                </Grid>
            </Border>

            <!-- Aralık / hata -->
            <TextBlock x:Name="HintText"
                       Grid.Row="2"
                       Margin="2,8,0,6"
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryText}"/>

            <!-- Tuşlar -->
            <UniformGrid Grid.Row="3" Rows="4" Columns="3" Margin="-5,0">
                <Button Content="7" Style="{StaticResource KeyButtonStyle}" Click="Digit_Click"/>
                <Button Content="8" Style="{StaticResource KeyButtonStyle}" Click="Digit_Click"/>
                <Button Content="9" Style="{StaticResource KeyButtonStyle}" Click="Digit_Click"/>
                <Button Content="4" Style="{StaticResource KeyButtonStyle}" Click="Digit_Click"/>
                <Button Content="5" Style="{StaticResource KeyButtonStyle}" Click="Digit_Click"/>
                <Button Content="6" Style="{StaticResource KeyButtonStyle}" Click="Digit_Click"/>
                <Button Content="1" Style="{StaticResource KeyButtonStyle}" Click="Digit_Click"/>
                <Button Content="2" Style="{StaticResource KeyButtonStyle}" Click="Digit_Click"/>
                <Button Content="3" Style="{StaticResource KeyButtonStyle}" Click="Digit_Click"/>
                <Button x:Name="DecimalButton" Content="," Style="{StaticResource KeyButtonStyle}" Click="Decimal_Click"/>
                <Button Content="0" Style="{StaticResource KeyButtonStyle}" Click="Digit_Click"/>
                <Button Content="⌫" Style="{StaticResource KeyButtonStyle}" Click="Backspace_Click"/>
            </UniformGrid>

            <!-- İşlemler -->
            <UniformGrid Grid.Row="4" Rows="1" Columns="3" Margin="-5,8,-5,0">
                <Button Content="TEMİZLE"
                        Height="64"
                        Margin="5"
                        Focusable="False"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="Clear_Click"/>
                <Button Content="İPTAL"
                        Height="64"
                        Margin="5"
                        Focusable="False"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="Cancel_Click"/>
                <Button x:Name="OkButton"
                        Content="TAMAM"
                        Height="64"
                        Margin="5"
                        Focusable="False"
                        Tag="Active"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="Ok_Click"/>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
