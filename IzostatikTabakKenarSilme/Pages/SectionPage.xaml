<Page x:Class="IzostatikTabakKenarSilme.Pages.SectionPage"
      Foreground="{DynamicResource PrimaryText}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="526" d:DesignWidth="1240"
      Background="Transparent"
      Title="SectionPage">

    <!-- Sağda dikey alt menü olan bölüm sayfası (AYARLAR, ÜRETİM).
         Alt sayfalar soldaki ContentFrame'de açılır. Öğeler koddan
         (SectionItem listesi) oluşturulur. -->
    <!-- Alt menü buton stili (SubMenuButtonStyle) App.xaml'da: Otomatik
         sayfasındaki ayar kısayolları da aynı stili kullanır. -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <Frame x:Name="ContentFrame"
               Grid.Column="0"
               NavigationUIVisibility="Hidden"
               Background="Transparent"/>

        <!-- Alt menü: kaydırma yok. Alan her zaman en az 12 eşit satıra
             bölünür (Rows koddan); butonlar mevcut yüksekliğe sığar.
             Az öğeli bölümlerde butonlar aynı boyda üstte durur. -->
        <UniformGrid x:Name="SubMenuPanel"
                     Grid.Column="2"
                     Columns="1"/>
    </Grid>
</Page>
