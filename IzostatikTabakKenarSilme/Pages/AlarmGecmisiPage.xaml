<Page x:Class="IzostatikTabakKenarSilme.Pages.AlarmGecmisiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:IzostatikTabakKenarSilme.Pages"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1035"
      Background="Transparent"
      Title="AlarmGecmisiPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Alarm Geçmişi"
                       FontSize="25"
                       FontWeight="Bold"/>
            <TextBlock Text="Gelen ve giden alarmlar (tarih, saat, alarm)"
                       Margin="0,5,0,0"
                       Foreground="{DynamicResource SecondaryText}"/>
        </StackPanel>

        <!-- Filtre ve işlem butonları -->
        <Grid Grid.Row="1" Margin="-4,0,-4,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0">
                <Button x:Name="TodayButton"
                        Content="BUGÜN"
                        CommandParameter="1"
                        Style="{StaticResource ActionButtonStyle}"
                        MinWidth="110"
                        Click="RangeButton_Click"/>
                <Button x:Name="Last7Button"
                        Content="SON 7 GÜN"
                        CommandParameter="7"
                        Style="{StaticResource ActionButtonStyle}"
                        MinWidth="110"
                        Click="RangeButton_Click"/>
                <Button x:Name="Last30Button"
                        Content="SON 30 GÜN"
                        CommandParameter="30"
                        Style="{StaticResource ActionButtonStyle}"
                        MinWidth="110"
                        Click="RangeButton_Click"/>
                <Button x:Name="AllButton"
                        Content="TÜMÜ (12 AY)"
                        CommandParameter="365"
                        Style="{StaticResource ActionButtonStyle}"
                        MinWidth="110"
                        Click="RangeButton_Click"/>
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RefreshButton"
                        Content="⟳ YENİLE"
                        Style="{StaticResource ActionButtonStyle}"
                        MinWidth="110"
                        Click="RefreshButton_Click"/>
                <Button x:Name="ActiveAlarmsButton"
                        Content="⚠ AKTİF ALARMLAR"
                        Style="{StaticResource ActionButtonStyle}"
                        MinWidth="170"
                        Click="ActiveAlarmsButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Kayıt sayısı / durum -->
        <TextBlock x:Name="InfoText"
                   Grid.Row="2"
                   Margin="0,0,0,8"
                   Text="Yükleniyor..."
                   Foreground="{DynamicResource SecondaryText}"/>

        <!-- Geçmiş listesi -->
        <DataGrid x:Name="HistoryGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  RowHeight="40"
                  FontSize="15"
                  ScrollViewer.PanningMode="VerticalOnly"
                  EnableRowVirtualization="True">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Tarih / Saat"
                                    Binding="{Binding Zaman}"
                                    Width="190"/>

                <DataGridTextColumn Header="No"
                                    Binding="{Binding No}"
                                    Width="70"/>

                <DataGridTextColumn Header="Alarm"
                                    Binding="{Binding Alarm}"
                                    Width="*"/>

                <DataGridTextColumn Header="Durum"
                                    Binding="{Binding Durum}"
                                    Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="Geldi">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorColor}"/>
                                </Trigger>
                                <Trigger Property="Text" Value="Gitti">
                                    <Setter Property="Foreground" Value="{DynamicResource OkColor}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
